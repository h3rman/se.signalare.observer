<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="se.signalare.observer">

    <permission
        android:name="se.signalare.observer.CONTROL_VPN"
        android:protectionLevel="normal" />

    <application android:name=".RethinkDnsApplication">
        <provider
            android:name=".provider.ApplicationProvider"
            android:authorities="se.signalare.observer.appprovider"
            android:enabled="true"
            android:exported="true"
            android:permission="se.signalare.observer.CONTROL_VPN" />
        <provider
            android:name=".provider.BlocklistProvider"
            android:authorities="se.signalare.observer.blocklistprovider"
            android:enabled="true"
            android:exported="true"
            android:permission="se.signalare.observer.CONTROL_VPN" />
        <provider
            android:name=".provider.DomainRuleProvider"
            android:authorities="se.signalare.observer.domainrulesprovider"
            android:enabled="true"
            android:exported="true"
            android:permission="se.signalare.observer.CONTROL_VPN" />

        <receiver
            android:name=".receiver.BraveStartReceiver"
            android:exported="true"
            android:permission="se.signalare.observer.CONTROL_VPN">
            <intent-filter>
                <action android:name="se.signalare.observer.intent.action.START_VPN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
